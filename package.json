{
  "name": "@prompteden/mcp-server",
  "version": "0.3.0",
  "description": "Stdio MCP server for PromptEden projects, monitors, captured answers, and analytics.",
  "mcpName": "io.github.yulanventures/prompteden-mcp",
  "license": "MIT",
  "type": "module",
  "bin": {
    "prompteden-mcp": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yulanventures/prompteden-mcp.git"
  },
  "homepage": "https://github.com/yulanventures/prompteden-mcp#readme",
  "bugs": {
    "url": "https://github.com/yulanventures/prompteden-mcp/issues"
  },
  "keywords": [
    "mcp",
    "ai-visibility",
    "answer-engine-optimization",
    "brand-monitoring",
    "marketing-analytics",
    "web-analytics",
    "small-business",
    "claude",
    "stdio"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node esbuild.config.mjs",
    "build": "npm run typecheck && npm run bundle",
    "help": "node dist/index.mjs --help",
    "test:client": "node scripts/run-client-tests.mjs",
    "test": "npm run test:client",
    "smoke": "node dist/index.mjs --help && node smoke.mjs",
    "tools:table": "node scripts/tools-table.mjs --check",
    "mcpb": "node scripts/build-mcpb.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^22.15.18",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3",
    "zod": "^3.24.4"
  }
}
